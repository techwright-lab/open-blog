<aside class="ob-sidebar">
  <%= render "open_blog/shared/search" %>
<% cache @sidebar_cache_key do %>
  <nav class="ob-sidebar-categories" aria-label="<%= open_blog_translate("navigation.categories") %>">
    <h2><%= open_blog_translate("navigation.categories") %></h2>
    <ul>
      <li><%= link_to open_blog_translate("navigation.all_posts"), open_blog_index_path, aria: { current: (@open_blog_page.kind == :index ? "page" : nil) } %></li>
      <% @sidebar_categories.each do |entry| %>
        <li>
          <%= link_to open_blog_list_path(:category, entry[:category]), aria: { current: (@open_blog_page.kind == :category && @open_blog_page.record == entry[:category] ? "page" : nil) } do %>
            <span><%= entry[:category].name %></span> <span class="ob-count"><%= entry[:count] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
  <% if @sidebar_tags.any? %>
    <nav class="ob-sidebar-tags" aria-label="<%= open_blog_translate("navigation.tags") %>">
      <h2><%= open_blog_translate("navigation.tags") %></h2>
      <ul>
        <% @sidebar_tags.each do |entry| %>
          <li><%= link_to entry[:tag].name, open_blog_list_path(:tag, entry[:tag]), aria: { current: (@open_blog_page.kind == :tag && @open_blog_page.record == entry[:tag] ? "page" : nil) } %></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
<% end %>
  <% if @popular_posts.any? %>
    <nav class="ob-sidebar-popular" aria-label="<%= open_blog_translate("navigation.popular") %>">
      <h2><%= open_blog_translate("navigation.popular") %></h2>
      <ol>
        <% @popular_posts.each do |post| %>
          <li><%= link_to post.title, post.path %></li>
        <% end %>
      </ol>
    </nav>
  <% end %>
  <nav class="ob-sidebar-feeds" aria-label="<%= open_blog_translate("navigation.subscribe") %>">
    <h2><%= open_blog_translate("navigation.subscribe") %></h2>
    <ul>
      <li><%= link_to open_blog_translate("navigation.feed"), open_blog_feed_path %></li>
      <li><%= link_to open_blog_translate("navigation.json_feed"), open_blog_feed_path(:json) %></li>
    </ul>
  </nav>
</aside>
