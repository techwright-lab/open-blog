#!/usr/bin/env ruby
require "rbconfig"

root = File.expand_path("..", __dir__)
tests = ARGV.empty? ? Dir[File.join(root, "test/**/*_test.rb")] : ARGV.map { |path| File.expand_path(path) }
abort "No test files found" if tests.empty?
Dir.chdir(File.join(root, "test/dummy")) do
  exec RbConfig.ruby, "bin/rails", "test", *tests
end
